GEMINI_API_KEY=your_gemini_api_key_here
ALLOWED_ORIGINS=http://localhost:5173,https://your-frontend-url.vercel.app
GEMINI_MODEL=gemini-2.5-flash

# Groq Cloud Ultra-Fast LPU Engine (Gemini + Groq Hybrid LLM Ensemble)
# GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=groq/compound

# Text-to-Speech Settings (Sarvam AI / ElevenLabs / Mock)
TTS_PROVIDER=sarvam
SARVAM_API_KEY=your_sarvam_api_subscription_key_here
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_SPEAKER=ritu

# ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
# ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
# ELEVENLABS_MODEL=eleven_multilingual_v2
MAX_TTS_CHARACTERS=9000

# Avatar & Video Settings (default "mock" for 0 budget cost)
AVATAR_PROVIDER=mock
# DID_API_KEY=your_did_api_key_here
# DID_PRESENTER_ID=samy_hq
MAX_AVATAR_SECONDS=150
# PUBLIC_BASE_URL=https://your-tunneled-domain.ngrok-free.app

# Speech-to-Text Settings (default "mock" for instant testing without heavy dependencies)
STT_PROVIDER=mock
WHISPER_MODEL=base

# Database Persistence Settings (Supabase Postgres Database Migration)
# Leave DATABASE_URL unset to use local SQLite (backend/data/app.db); set this in production to your Supabase session pooler connection string.
# DATABASE_URL=postgresql://postgres.your-project-ref:your-password@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# Supabase Auth Settings (Phase 14 Real Verification)
# SUPABASE_URL=https://your-project-ref.supabase.co
# SUPABASE_JWT_AUDIENCE=authenticated
# ALLOW_UNVERIFIED_AUTH_FALLBACK=false  # CRITICAL SECURITY NOTE: Must remain false in production/Render. Set true ONLY for unverified local dev without Supabase.

# Upstash Redis Rate Limiting Settings
# Leave unset to disable rate limiting locally.
# UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token

